<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- menu-bar app: no Dock icon -->
  <key>LSUIElement</key>
  <true/>
  <!-- Services menu: search the selected text (selection.rs) -->
  <key>NSServices</key>
  <array>
    <dict>
      <key>NSMenuItem</key>
      <dict>
        <key>default</key>
        <string>Search Papers</string>
      </dict>
      <key>NSMessage</key>
      <string>searchPapers</string>
      <key>NSPortName</key>
      <string>Papers Desktop</string>
      <key>NSSendTypes</key>
      <array>
        <string>public.utf8-plain-text</string>
      </array>
      <key>NSRequiredContext</key>
      <dict/>
    </dict>
  </array>
</dict>
</plist>
