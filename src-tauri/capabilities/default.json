{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the search panel and the settings window",
  "windows": ["panel", "settings"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "opener:default",
    "dialog:default",
    "drag:default"
  ]
}
