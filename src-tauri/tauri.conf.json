{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Papers Desktop",
  "version": "0.4.4",
  "identifier": "io.github.alex-robinson.papers-desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "panel",
        "title": "Papers",
        "width": 720,
        "height": 460,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk4QTEzRjlCNzdFRjc3NjEKUldSaGQrOTNteitobUM1WlhmMDNGdThzaFJaNUZUM2hDQytEQUNkK01waUFkcVNnUitYNWh6SmgK",
      "endpoints": [
        "https://github.com/mathesislab/papers-desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
