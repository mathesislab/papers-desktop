{
  "description": "config --global lists, sets and unsets the settings of the machine",
  "steps": [
    {
      "argv": [
        "config",
        "--global"
      ]
    },
    {
      "argv": [
        "config",
        "--global",
        "editor",
        "vim"
      ]
    },
    {
      "argv": [
        "config",
        "--global",
        "name.template",
        "{author}_{year}"
      ]
    },
    {
      "argv": [
        "config",
        "--global",
        "history-size",
        "50"
      ]
    },
    {
      "argv": [
        "config",
        "--global",
        "keep-deleted-files",
        "false"
      ]
    },
    {
      "argv": [
        "config",
        "--global"
      ]
    },
    {
      "argv": [
        "config"
      ]
    },
    {
      "argv": [
        "config",
        "--global",
        "--unset",
        "editor"
      ]
    },
    {
      "argv": [
        "config",
        "--global"
      ]
    },
    {
      "argv": [
        "config",
        "--global",
        "bibtex",
        "x.bib"
      ]
    },
    {
      "argv": [
        "config",
        "--global",
        "pool",
        "none"
      ]
    }
  ]
}
