[
  {"name": "w", "rules": [["\\w+", "[\\g<0>]"]]},
  {"name": "W", "rules": [["\\W+", "<\\g<0>>"]]},
  {"name": "d", "rules": [["\\d+", "#"]]},
  {"name": "D", "rules": [["\\D+", "~D~"]]},
  {"name": "s", "rules": [["\\s+", "_"]]},
  {"name": "S", "rules": [["\\S+", "(\\g<0>)"]]},
  {"name": "b_start", "rules": [["\\b\\w", "<\\g<0>"]]},
  {"name": "b_end", "rules": [["\\w\\b", "\\g<0>>"]]},
  {"name": "B", "rules": [["\\B\\w", "."]]},
  {"name": "B_nonword", "rules": [["\\B\\W", "!"]]},
  {"name": "set_word_dash", "rules": [["[\\w-]+", "(\\g<0>)"]]},
  {"name": "set_letters", "rules": [["[^\\W\\d_]+", "L"]]},
  {"name": "set_digits_spaces", "rules": [["[\\d\\s]+", "N"]]},
  {"name": "set_not_space_word", "rules": [["[^\\s\\w]+", "P"]]},
  {"name": "set_nonword_digit", "rules": [["[\\W\\d]+", "x"]]},
  {"name": "set_mixed", "rules": [["[a-c\\W_]+", "m"]]},
  {"name": "ascii_w", "rules": [["(?a)\\w+", "[\\g<0>]"]]},
  {"name": "ascii_W", "rules": [["(?a)\\W+", "<\\g<0>>"]]},
  {"name": "ascii_s", "rules": [["(?a)\\s+", "_"]]},
  {"name": "ascii_d", "rules": [["(?a)\\d+", "#"]]},
  {"name": "ascii_b", "rules": [["(?a)\\b\\w", "<\\g<0>"]]},
  {"name": "ascii_set", "rules": [["(?a)[^\\W]+", "A"]]},
  {"name": "ascii_scoped", "rules": [["(?a:\\w)+(?u:\\w)+", "<\\g<0>>"]]},
  {"name": "ignorecase_w", "rules": [["(?i)\\w+", "[\\g<0>]"]]},
  {"name": "ignorecase_set", "rules": [["(?i)[-_\\W]+", "I"]]},
  {"name": "ignorecase_negated_set", "rules": [["(?i)[^-_\\W]+", "J"]]},
  {"name": "ignorecase_b", "rules": [["(?i)\\bK\\w*", "<\\g<0>>"]]},
  {"name": "many", "rules": [["\\d+", "D"], ["\\w+", "W"], ["\\s+", "_"]]},
  {"name": "lookbehind", "rules": [["(?<=\\w)\\W+", "-"], ["(?<!\\w)\\d", "0"]]},
  {"name": "lookahead", "rules": [["\\w+(?=\\s)", "(\\g<0>)"], ["\\S(?!\\w)", "|"]]},
  {"name": "end", "rules": [["\\w+$", "END"], ["\\s+\\Z", "ZZ"]]}
]
