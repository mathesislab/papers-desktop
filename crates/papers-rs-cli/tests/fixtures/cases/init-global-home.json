    "cwd/~/papers/lib/.papers/.gitignore": "*\n",
    "cwd/~/papers/lib/.papers/config.json": "{\n  \"bibtex\": \"papers.bib\",\n  \"filesdir\": \"files\",\n  \"pool\": \"none\",\n  \"version\": 3\n}",
    "home/<MC>": "{\n  \"default\": \"<TMP>/cwd/~/papers/lib\",\n  \"version\": 3\n}"
   }
  },
  {
   "args": [
    "init",
    "libb",
    "--shallow"
   ],
   "cwd": ".",
   "write": {},
   "rm": [],
   "env": {},
   "rc": 0,
   "stdout": "created the library <TMP>/cwd/libb\n* bibtex:  papers.bib\n* files:   in the pool (shallow library)\n* pool:    <TMP>/cwd/~/papers/lib\n`papers config` lists and sets the settings\n",
