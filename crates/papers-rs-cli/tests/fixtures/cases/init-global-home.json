{
 "name": "init-global-home",
 "home": {},
 "cwd": {},
 "platform": null,
 "steps": [
  {
   "args": [
    "init",
    "~/papers/lib",
    "--global"
   ],
   "cwd": ".",
   "write": {},
   "rm": [],
   "env": {},
   "rc": 0,
   "stdout": "created the library <TMP>/cwd/~/papers/lib\n* bibtex:  papers.bib\n* files:   files (the files directory of the library)\n`papers config` lists and sets the settings\nregistered <TMP>/cwd/~/papers/lib as the default library in <MC~>\n",
   "stderr": "",
   "tree": {
    "cwd/~/papers/lib/papers.bib": "",
    "cwd/~/papers/lib/files/": null,
    "cwd/~/papers/lib/.papers/.gitignore": "*\n",
    "cwd/~/papers/lib/.papers/config.json": "{\n  \"bibtex\": \"papers.bib\",\n  \"filesdir\": \"files\",\n  \"pool\": \"none\",\n  \"version\": 3\n}",
    "home/<MC>": "{\n  \"default\": \"<TMP>/cwd/~/papers/lib\",\n  \"version\": 3\n}"
   }
  },
  {
   "args": [
    "config",
    "--global"
   ],
   "cwd": ".",
   "write": {},
   "rm": [],
